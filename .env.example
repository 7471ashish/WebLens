
# Brand AI Readiness Audit — Environment Configuration Example (.env.example)

# Copy this file to .env and provide your own API credentials if you wish to enable
# optional qualitative LLM reasoning. The entire audit pipeline operates with 100%
# fidelity in offline fail-soft mode when no API keys are provided.


# Primary LLM Provider: Groq Cloud API (Optional - for high-throughput qualitative reasoning)
GROQ_API_KEY=your_groq_api_key_here

# Alternative LLM Provider: OpenRouter API (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Alternative LLM Provider: OpenAI API (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Optional LLM Model Configurations (Defaults apply automatically if omitted)
# AUDIT_TEXT_MODEL=openai/gpt-oss-120b
# AUDIT_VISION_MODEL=qwen/qwen3.6-27b
# AUDIT_LLM_TIMEOUT=10.0
