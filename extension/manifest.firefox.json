{
  "manifest_version": 3,
  "name": "WebLens - AI Technical Health Auditor",
  "version": "1.0.1",
  "description": "Autonomous technical website audit: AI discoverability, WCAG accessibility, rendering, and engagement friction.",
  "browser_specific_settings": {
    "gecko": {
      "id": "weblens-auditor@weblens.ai",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://weblens-backend-i7n8.onrender.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8001/*",
    "http://127.0.0.1:8001/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Open WebLens Audit Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "sidebar_action": {
    "default_title": "WebLens Auditor",
    "default_panel": "side_panel.html",
    "default_icon": "icons/icon48.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
